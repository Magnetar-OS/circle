<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>com.magnetaros.Circle</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-only</project_license>
  <name>Circle</name>
  <summary>Find and edit the people in your address book</summary>
  <developer id="com.magnetaros">
    <name>entro314 labs</name>
  </developer>
  <description>
    <p>
      Circle is the contacts application for the COSMIC desktop. Contacts are
      plain vCard files in a vdir layout, so they stay readable by khard,
      vdirsyncer, and anything else that speaks .vcf.
    </p>
    <p>
      Editing a contact patches the stored card rather than rebuilding it, so
      photos, custom labels, and every property Circle does not itself display
      survive an edit and a sync.
    </p>
    <p>
      Accounts are shared with the rest of the suite: an account added in Slate
      is already here, with one password in the system keyring rather than one
      per application.
    </p>
  </description>
  <icon type="remote" width="64" height="64" scale="1">
    https://github.com/Magnetar-OS/circle/raw/main/resources/icons/hicolor/scalable/apps/com.magnetaros.Circle.svg
  </icon>
  <url type="homepage">https://github.com/Magnetar-OS/circle</url>
  <url type="bugtracker">https://github.com/Magnetar-OS/circle/issues</url>
  <url type="vcs-browser">https://github.com/Magnetar-OS/circle</url>
  <launchable type="desktop-id">com.magnetaros.Circle.desktop</launchable>
  <provides>
    <!-- How an application says it belongs to COSMIC. The desktop's own store
         and app library filter on this id; without it Circle is an ordinary
         Office application to them. -->
    <id>com.system76.CosmicApplication</id>
    <binary>circle</binary>
  </provides>
  <requires>
    <display_length compare="ge">360</display_length>
  </requires>
  <supports>
    <control>keyboard</control>
    <control>pointing</control>
    <control>touch</control>
  </supports>
  <categories>
    <category>Office</category>
    <category>ContactManagement</category>
  </categories>
  <keywords>
    <keyword>contacts</keyword>
    <keyword>address book</keyword>
    <keyword>vCard</keyword>
  </keywords>
  <!--
    Screenshots are fetched by a software centre, so they are URLs into the
    repository rather than files beside the metainfo. Taken on a real COSMIC
    session against a scratch address book — none of the people in it exist.
  -->
  <screenshots>
    <screenshot type="default">
      <caption>Address books, groups, and the contact list</caption>
      <image type="source" width="1373" height="871">https://github.com/Magnetar-OS/circle/raw/main/resources/screenshots/contacts.png</image>
    </screenshot>
  </screenshots>
  <content_rating type="oars-1.1" />
  <!-- The coral of the app icon; software centres tint the page header with it. -->
  <branding>
    <color type="primary" scheme_preference="light">#ff7a6b</color>
    <color type="primary" scheme_preference="dark">#c93d3d</color>
  </branding>
  <releases>
    <release version="0.1.0" date="2026-08-24">
      <description>
        <p>First release.</p>
      </description>
    </release>
  </releases>
</component>
